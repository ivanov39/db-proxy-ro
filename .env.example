# Copy to .env and adjust. Every variable is optional.

# Where the proxy listens (host networking: these are host addresses).
DBPROXY_PGSQL_LISTEN=127.0.0.1:25432
DBPROXY_MYSQL_LISTEN=127.0.0.1:23306

# debug | info | warn | error
DBPROXY_LOG_LEVEL=info

# How long to wait for a backend database when a client connects.
DBPROXY_CONNECT_TIMEOUT=10s

# Version string shown to MySQL clients in the server greeting.
DBPROXY_MYSQL_SERVER_VERSION=8.0.36-db-proxy-ro

# User the container runs as; must be able to read ./params and write ./logs.
DBPROXY_UID=1000
DBPROXY_GID=1000
